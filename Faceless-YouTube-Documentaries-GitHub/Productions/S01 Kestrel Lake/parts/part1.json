      "params": { "time": "day", "exhaust": true, "snowfall": 0.6 },
      "camera": { "from": [1.12, -0.05, 0.02], "to": [1.0, 0, 0] },
      "vo": [{ "who": "noah", "text": "My name is *Noah*. I'm fifteen. This is my grandpa's cabin on Kestrel Lake, about forty miles from anything with a name." }],
      "pad": [0.5, 0.6], "music": "cabin",
      "sfx": [{ "name": "wind", "at": 0, "loop": true, "gain": -24 }, { "name": "hum", "at": 0, "loop": true, "gain": -30 }],
      "hud": { "visible": false }, "transition": "fade"
    },
    {
      "id": "s04", "scene": "int_cabin",
      "params": { "time": "day", "noah": { "x": 0.30, "pose": "stand", "eyes": "normal" }, "june": { "x": 0.62, "pose": "sit", "eyes": "normal" }, "biscuit": "sleep", "focus": "june" },
      "camera": { "from": [1.25, 0.12, 0.05], "to": [1.1, 0.06, 0.04] },
      "vo": [{ "who": "noah", "text": "That's my sister, *June*. She's eight. And that's *Biscuit*. He's a beagle, and he's twelve, which in dog years means he's allowed to sleep all day." }],
      "pad": [0.3, 0.5], "music": "cabin",
      "sfx": [{ "name": "hum", "at": 0, "loop": true, "gain": -26 }, { "name": "snore", "at": 5.5, "gain": -18 }],
