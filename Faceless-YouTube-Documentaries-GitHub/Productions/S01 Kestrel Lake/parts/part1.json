      "vo": [{ "who": "noah", "text": "Two of them. Taller than any person I know. Each with one white eye... that didn't *blink*." }],
      "pad": [0.6, 1.0], "music": "dread",
      "sfx": [{ "name": "riser", "at": 0, "gain": -16 }, { "name": "heartbeat", "at": 1.0, "gain": -12 }, { "name": "wind", "at": 0, "loop": true, "gain": -22 }],
