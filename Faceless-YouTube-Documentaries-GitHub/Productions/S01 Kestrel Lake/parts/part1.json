      "id": "s06", "scene": "shed",
      "params": { "time": "day", "candle": false },
      "camera": { "from": [1.0, 0, 0], "to": [1.15, 0.05, 0.02] },
      "vo": [{ "who": "noah", "text": "Grandpa said not to worry. He dragged the old generator into the shed and got it running. That *hum* has been the only sound out here ever since." }],
      "pad": [0.3, 0.7], "music": "cabin",
      "sfx": [{ "name": "hum", "at": 0, "loop": true, "gain": -16 }],
      "hud": { "visible": true, "day": "01", "fuel": 5, "tall": 0, "headache": 1, "air": "SAFE ✓", "clock": "07:40 AM" }
    },
    {
