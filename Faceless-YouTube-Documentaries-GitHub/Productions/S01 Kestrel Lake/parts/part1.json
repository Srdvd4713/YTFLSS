      "camera": { "from": [1.0, 0, 0], "to": [1.12, -0.06, 0] },
      "vo": [{ "who": "noah", "text": "I went out for wood. And the weird thing is... out there, by the woodpile, the headache just... *faded*. Like the cold was squeezing it out." }],
      "pad": [0.3, 0.8], "music": "cabin",
