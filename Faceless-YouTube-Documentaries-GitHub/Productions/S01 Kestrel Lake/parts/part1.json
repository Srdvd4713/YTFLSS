      "camera": { "from": [1.0, 0, 0], "to": [1.2, 0.08, 0.06] },
      "vo": [{ "who": "noah", "text": "Then this morning, Grandpa was *gone*. His snowmobile was gone. And on the table, there was this." }],
      "pad": [0.3, 0.5], "music": "tension",
      "sfx": [{ "name": "hum", "at": 0, "loop": true, "gain": -26 }]
    },
