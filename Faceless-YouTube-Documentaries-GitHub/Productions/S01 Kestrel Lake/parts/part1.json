      "vo": [{ "who": "noah", "text": "Rule one. Keep the *hum* going. The hum means we're okay." }],
      "pad": [0.9, 0.8], "music": "rules",
      "sfx": [{ "name": "flip", "at": 0.15, "gain": -8 }, { "name": "hum", "at": 0, "loop": true, "gain": -24 }]
    },
    {
      "id": "s12", "scene": "rule_card",
      "params": { "n": 2, "text": "KEEP EVERY WINDOW SHUT." },
      "vo": [
        { "who": "noah", "text": "Rule two. Keep every window *shut*." },
        { "who": "june", "text": "But it's so stuffy in here." },
        { "who": "noah", "text": "Rule two, June." }
      ],
      "pad": [0.9, 0.8], "music": "rules",
