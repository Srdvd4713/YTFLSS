      "id": "s08", "scene": "note",
      "params": { "smudge": true, "bleed": true },
      "camera": { "from": [1.0, 0, 0], "to": [1.1, 0.0, 0.03] },
      "vo": [{ "who": "noah", "text": "Gone for help. Head is pounding. Something is in the air. Keep the windows... and that's where June spilled her cocoa. I'm pretty sure it says *shut*." }],
      "pad": [0.4, 0.8], "music": "tension",
      "sfx": [{ "name": "paper", "at": 0.1, "gain": -14 }, { "name": "hum", "at": 0, "loop": true, "gain": -30 }]
    },
    {
      "id": "s09", "scene": "window_pov",
      "params": { "time": "day", "tall": 0, "frost": true },
      "camera": { "from": [1.05, 0, 0], "to": [1.2, 0, -0.03] },
      "vo": [{ "who": "noah", "text": "Something is in the air. So whatever took the sound out of the world... is *outside*. Breathing the same air we are." }],
      "pad": [0.3, 0.8], "music": "tension",
      "sfx": [{ "name": "wind", "at": 0, "loop": true, "gain": -18 }]
    },
