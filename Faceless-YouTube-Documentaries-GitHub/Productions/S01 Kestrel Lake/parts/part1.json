      "camera": { "from": [1.1, 0, 0.03], "to": [1.25, 0.02, 0.05] },
      "vo": [{ "who": "noah", "text": "So I did what Grandpa would do. I made *rules*." }],
      "pad": [0.2, 0.4], "music": "tension",
