      "params": { "time": "noon", "noah": { "x": 0.35, "pose": "hold_head", "eyes": "closed" }, "june": { "x": 0.62, "pose": "sit", "eyes": "sleepy" }, "biscuit": "sleep", "focus": "noah", "pain": true },
      "camera": { "from": [1.15, -0.02, 0.04], "to": [1.3, -0.05, 0.06] },
      "vo": [{ "who": "noah", "text": "By noon, my head was *pounding*. June's too. I figured it was the Quiet. Pressure, like before a storm." }],
      "pad": [0.3, 0.6], "music": "tension",
      "sfx": [{ "name": "hum", "at": 0, "loop": true, "gain": -22 }, { "name": "ring", "at": 0.5, "gain": -24 }],
