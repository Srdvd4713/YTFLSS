      "params": { "time": "day", "noah": { "x": 0.30, "pose": "stand", "eyes": "side" }, "june": { "x": 0.62, "pose": "sit", "eyes": "normal" }, "biscuit": "sleep", "radio": true, "focus": "radio" },
      "camera": { "from": [1.0, 0, 0], "to": [1.08, -0.04, 0] },
      "vo": [{ "who": "noah", "text": "Three days ago, the blizzard hit. The power went out. The phones went dead. And the radio... just *hiss*." }],
      "pad": [0.3, 0.8], "music": "cabin",
      "sfx": [{ "name": "hum", "at": 0, "loop": true, "gain": -26 }, { "name": "static", "at": -2.6, "gain": -18 }]
    },
